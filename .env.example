# Browser-visible API endpoint. Never place database credentials here.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Passed to Flutter with --dart-define, not loaded as a runtime secret.
EXECLINK_API_BASE_URL=http://127.0.0.1:8000/api/v1
EXECLINK_ENVIRONMENT=development

# Backend-only configuration. PostgreSQL/Neon is intentionally not enabled yet.
DATABASE_URL=sqlite:///services/api/execlink.db
EXECLINK_JWT_SECRET=replace-with-a-local-development-secret
