{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://execlink.local/schemas/verify-match.schema.json",
  "title": "VerifyMatchCommand",
  "type": "object",
  "additionalProperties": false,
  "required": ["activityId", "progressPercent", "expectedActivityVersion"],
  "properties": { "activityId": { "type": "string", "minLength": 1 }, "progressPercent": { "type": "number", "minimum": 0, "maximum": 100 }, "expectedActivityVersion": { "type": "integer", "minimum": 0 }, "note": { "type": "string", "maxLength": 2000 }, "actualQuantity": { "$ref": "schedule-activity.schema.json#/$defs/quantity" } }
}
